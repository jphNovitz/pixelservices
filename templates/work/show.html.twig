{% extends 'base.html.twig' %}

{% block title %}{{ work.seoTitle }}{% endblock %}
{% block metas %}
    <meta name="description"
          content=" {{ work.seoDescription }}"/>
    <meta name="keywords" content="site web, ecommerce, vitrine, site vitrine, wp, wordpress, wix"/>
{% endblock %}
{% block og_title %}{{ work.seoTitle }}{% endblock %}
{% block og_image %}{{ asset("images/blog/"~work.image) }} {% endblock %}
{% block og_image_alt %}{{ work.seoTitle }}{% endblock %}
{% block og_description %}{{ work.seoDescription }}{% endblock %}
{% block twitter_title %}{{ work.seoTitle }}{% endblock %}
{% block twitter_description %}{{ work.seoDescription }}{% endblock %}
{% block twitter_image %}{{ asset("images/blog/"~work.image) }} {% endblock %}
{% block twitter_image_alt %}{{ work.seoTitle }}{% endblock %}
{% block body %}
    <div class="w-full h-full flex flex-col justify-around  md:w-2/3 m-auto">

        <twig:Title:H1 class="my-16 pb-16 text-center border-b border-indigo-800"> {{ work.name }} </twig:Title:H1>
         <p>{{ work.descriptionShort|striptags }}</p>
        {% if work.image is not empty %}
            <figure class="w-full text-center">
                <img class="w-full  md:w-3/4 h-auto  mx-auto  my-8  rounded-lg shadow-md"
                     src="{{ asset("images/work/"~work.image) }}"
                            alt="{{ work.name }}"
                        />
            </figure>
        {% endif %}

        <div class="leading-loose">
            {{ work.descriptionLong|raw }}
        </div>

        <div class="my-16">
            {% if work.demoUrl is not null %}
            {#            <a href="{{ path('app_contact') }}"#}
            <a href="{{ work.demoUrl }}"
               title="voir la demo"
               class="btn btn-primary">
                <span class="capitalize">Voir la demo</span>
{#                <span class="capitalize">Je veux {{ work.name }}</span>#}
            </a>
            {% endif %}
        </div>

    </div>
{% endblock %}
