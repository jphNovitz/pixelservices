{% extends 'base.html.twig' %}

{% block title %} Service {{ work.name }}{% endblock %}
{% block og_title %}Service {{ work.name }}{% endblock %}
    {% block og_image %}
        {% if work.image is defined  %}
            {{ asset("images/work/"~work.image) }} {% endif %}
    {% endblock %}
{% block og_description %} {{ work.descriptionShort|striptags }}{% endblock %}
{% block metas %}
    <meta name="description"
          content=" {{ work.descriptionShort|striptags }}"/>
{% endblock %}
{% block body %}
    <div class="w-full h-full flex flex-col justify-around  md:w-2/3 m-auto">

        <twig:Title:H1 class="my-16 pb-16 text-center border-b border-indigo-800"> {{ work.name }} </twig:Title:H1>
         <p>{{ {{ work.descriptionShort|striptags }} }}</p>
        {% if work.image is not empty %}
            <figure class="w-full text-center">
                <img class="w-full  md:w-3/4 h-auto  mx-auto  my-8  rounded-lg shadow-md"
                     src="{{ asset("images/"~work.image) }}"
                            alt="{{ work.name }}"
                        />
            </figure>
        {% endif %}

        <div class="leading-loose">
            {{ work.descriptionLong|raw }}
        </div>

        <div class="my-16">
            {% if work.demoUrl is not null %}
            {#            <a href="{{ path('app_contact') }}"#}
            <a href="{{ work.demoUrl }}"
               title="voir la demo"
               class="inline-flex items-center justify-center rounded-full bg-indigo-600 px-4 py-2 text-base font-bold leading-7 text-white shadow-sm ring-2 ring-indigo-800 hover:font-black hover:text-indigo-900 hover:bg-indigo-100 hover:ring-indigo-900">
                <span class="capitalize">Voir la demo</span>
{#                <span class="capitalize">Je veux {{ work.name }}</span>#}
            </a>
            {% endif %}
        </div>

    </div>
{% endblock %}
