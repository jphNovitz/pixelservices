{% extends 'base.html.twig' %}

{% block title %} Découvrez mes services pour booster votre présence en ligne{% if works['general'] is defined %} {% for work in works['general'] %}{{ work.name }} {% if  not loop.last %},{% endif %} {% endfor %} {% endif %} | Jphweb{% endblock %}
{% block og_title %}Découvrez mes services pour booster votre présence en ligne {% if works['general'] is defined %}({% for work in works['general'] %}{{ work.name }} {% if  not loop.last %},{% endif %} {% endfor %}) {% endif %}{% endblock %}
{#    {% block og_image %} #}
{#        {% if work.image is defined  %} #}
{#            {{ asset("images/work/"~work.image) }} {% endif %} #}
{#    {% endblock %} #}
{% block og_description %} Services: {% for work in works['front'] %}{{ work.name }} {% if  not loop.last %},{% endif %} {% endfor %} {% endblock %}
{% block metas %}
    <meta name="description"
          content="  Services: {% for work in works['front'] %}{{ work.name }} {% if not loop.last %},{% endif %} {% endfor %} "/>
{#    <meta name="description"#}
{#          content="  Services: {% for work in works['front'] %}{{ work.name }} {% if not loop.last %},{% endif %} {% endfor %} "/>#}
{% endblock %}

{% block body %}

    <section class="">
        <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
            <div class="mx-auto max-w-screen-md text-left mb-8 lg:mb-12">
                <twig:Title:H1>Jphiweb: Des
                    <span class="text-primary">solutions web</span> adaptées à vos besoins
                </twig:Title:H1>
                <twig:Title:H2> Que vous soyez indépendant ou
                    entreprise, je vous accompagne pour concrétiser vos <span class="border-b-2 border-primary"> projets numériques</span>.
                </twig:Title:H2>
            </div>

            <!-- services card container -->
            <div class="space-y-8 lg:grid lg:grid-cols-3 sm:gap-6 xl:gap-10 lg:space-y-0">
                <!-- Service Card -->
                <div class="bg-base-100 flex flex-col justify-between p-6 mx-auto max-w-lg rounded-lg border border-base-content/10 shadow xl:p-8">
                    <h3 class="mb-4 text-2xl font-semibold text-left">Vous partez de zéro ? <br/>On démarre ensemble !
                    </h3>
                    <p class="font-light text-gray-500 sm:text-lg dark:text-gray-400 text-balance text-left">
                        Vous lancez votre activité et n’avez encore rien en ligne ?
                        Voici trois solutions simples pour établir une première présence pro :
                    </p>
                    <ul class="py-4">
                        <li><a class="link link-primary"
                               href="{{ path('app.works.show', {'slug': 'creation-de-site-vitrine'}) }}">
                                Site vitrine</a></li>
                        <li><a class="link link-primary"
                               href="{{ path('app.works.show', {'slug': 'creation-site-web-carte-de-visite'}) }}">
                                Carte de visite virtuelle</a></li>
                        <li>{#<a class="link link-primary"
                               href="{{ path('app.works.show', {'slug': 'bio-link-la-carte-de-visite-numerique-ideale-pour-les-independants-du-brabant-wallon'}) }}">#}
                            Page bio-link{#</a>#}</li>
                        <li>{#<a class="link link-primary"
                               href="{{ path('app.', {'slug': 'une-page-coming-soon'}) }}">#}
                                Page “Coming
                                Soon”
                            {#</a>#}
                        </li>
                        <li><a class="link link-primary"
                               href="{{ path('app.works.show', {'slug': 'quest-ce-quune-landing-page-guide-complet-pour-les-entreprises-du-brabant-wallon'}) }}">Landing
                                page</a></li>
                    </ul>

                </div>
                <!-- Service Card -->
                <div class="bg-base-100 flex flex-col justify-between p-6 mx-auto max-w-lg rounded-lg border border-base-content/10 shadow xl:p-8">
                  <h3 class="mb-4 text-2xl font-semibold text-left">Faites évoluer votre site web</h3>
                    <p class="font-light text-gray-500 sm:text-lg dark:text-gray-400 text-balance text-left">
                        Vous avez déjà une landing page ou un site en ligne, il date un peu ? <br/>
                        Offrez-lui une seconde jeunesse ou faites-le évoluer vers un outil plus performant.
                        Voici quelques services pour passer à l’étape suivante :
                    </p>
                    <ul class="py-4">
                        <li>Refonte légère du site</li>
                        <li>Ajout d'une section, d'une fonctionnalité (section blog, actualités ...)</li>
                        <li>Adaptation du site web au responsive ou mobilel first</li>
                        <li>Réparation de petits bugs ou defauts</li>
                        <li>Migration vers un autre hebergeur</li>

                    </ul>

                </div>
                <!-- Service Card -->
                <div class="bg-base-100 flex flex-col justify-between p-6 mx-auto max-w-lg rounded-lg border border-base-content/10 shadow xl:p-8">
                    <h3 class="mb-4 text-2xl font-semibold text-left">Votre projet est clair, passons à l’action</h3>
                    <p class="font-light text-gray-500 sm:text-lg dark:text-gray-400 text-balance text-left">
                        Qu’il s’agisse d’un projet personnel ambitieux, d’un changement technologique ou du lancement
                        d’un e-commerce, je vous accompagne sur mesure.
                        <br/> Voici quelques pistes : </p>
                    <ul class="py-4">
                        <li>Refonte complète de site</li>
                        <li>Migration vers une nouvelle technologie</li>
                        <li>Création de boutique en ligne</li>
                        <li>Développement sur mesure</li>
                    </ul>

                </div>
            </div>
        </div>
    </section>
    
    <section class="hero bg-base-100 py-4">
      <div class="hero-content flex-col lg:flex-row-reverse">
        <div>
          <p class="py-6">
             Vous avez une idée, un projet précis ou simplement l’envie de vous lancer ?  
             Qu’il s’agisse d’un site vitrine, d’une boutique en ligne ou d’une solution sur mesure, je vous aide à concrétiser votre vision.  
             Vous pouvez commencer petit et évoluer ensuite — l’important, c’est de commencer.
           </p>
          <a href="{{ path('app_contact') }}" class="btn btn-primary">Discutons ensemble de votre projet</a>
        </div>
      </div>
    </section>

    <p>
      Contact via notre <a href="{{ path('app_contact') }}" class="">la page contact</a> ou par 
      email <a href="mailto:bonjour@jphiweb.be" class="link">bonjour@jphiweb.be</a>
    </p>    

{% endblock %}
