{% extends 'base.html.twig' %}

{% block title %}{{ type.label() }} — Jphiweb{% endblock %}

{% block breadcrumb %}
    <div class="breadcrumbs flex justify-start md:justify-center pt-8 text-xs">
        <ul class="max-w-full flex flex-col md:flex-row !items-start md:!items-center space-x-2 ">
            <li><a href="{{ path('app_home') }}">Accueil</a></li>
            <li class="!mt-0"><a href="{{ path('app_work_index') }}">services</a></li>
            <li class="!mt-0 text-ellipsis overflow-hidden">{{ type.value }}</li>
        </ul>
    </div>
{% endblock %}

{% block body %}

    {# ── Header de section ─────────────────────────────────────────────────────── #}
    <section class="bg-base-100 border-b border-base-200">
        <div class="max-w-5xl mx-auto px-6 py-12">

            <a href="{{ path('app_work_index') }}"
               class="text-sm text-base-content/40 inline-flex items-center gap-1 mb-6 hover:text-base-content/60">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 5l-7 7 7 7"/>
                </svg>
                Tous les services
            </a>

            <h1 class="text-3xl lg:text-4xl font-bold text-base-content">
                {{ type.label() }}
            </h1>

        </div>
    </section>

    {# ── Liste des works ───────────────────────────────────────────────────────── #}
    <section class="bg-base-200">
        <div class="max-w-5xl mx-auto px-6 py-12">

            {% if works is empty %}
                <p class="text-base-content/50 text-sm">Aucun service disponible pour le moment.</p>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

                    {% for work in works %}
                        <a href="{{ path('app_work_show', {type: work.type.value, slug: work.slug}) }}"
                           class="card bg-base-100 border border-base-200 shadow-none hover:border-primary/30 hover:shadow-sm transition-all">
                            <figure class="aspect-square overflow-hidden">
                                {% if work.image %}
                                <img src="/images/work/{{ asset(work.image) }}" alt="{{ work.name }}"
                                     class="w-full h-full object-cover">
                                {% else %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="size-16 text-base-content/20" fill="none"
                                     viewBox="0 0 24 24" stroke="currentColor">

                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>

                                </svg>
                            </figure>

                            {% endif %}

                            <div class="card-body gap-3">
                                <h2 class="card-title text-base font-semibold">{{ work.name }}</h2>

                                {% if work.descriptionShort %}
                                    <p class="text-sm text-base-content/60 leading-relaxed">
                                        {{ work.descriptionShort }}
                                    </p>
                                {% endif %}

                                {% if work.price %}
                                    <p class="text-sm font-medium text-primary mt-auto">
                                        À partir de {{ work.price }} €
                                    </p>
                                {% endif %}
                            </div>

                        </a>
                    {% endfor %}

                </div>
            {% endif %}

        </div>
    </section>

{% endblock %}