<div class="w-full sticky top-0 z-10 bg-white ">
    <nav class="bg-transparent w-full md:max-w-6xl lg:max-w-7xl m-auto" x-data="{ mobileMenuOpen: false }">
        <div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8 grid grid-cols-12">
            <div class="relative flex h-16 items-center justify-between col-span-12 md:col-span-2">
                <div class="absolute inset-y-0 left-0 flex items-center md:hidden">
                    <!-- Mobile menu button-->
                    <button type="button"
                            x-on:click="mobileMenuOpen = !mobileMenuOpen"
                            class="inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-gray-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white"
                            aria-controls="mobile-menu" aria-expanded="false">
                        <span class="sr-only">{% trans %} nav.Open_main_menu {% endtrans %}</span>
                        <!--
                          Icon when menu is closed.

                          Heroicon name: outline/bars-3

                          Menu open: "hidden", Menu closed: "block"
                        -->
                        <svg x-bind:class="{'hidden' : mobileMenuOpen}"
                             class="block h-12 w-12" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="2" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
                        </svg>
                        <!--
                          Icon when menu is open.

                          Heroicon name: outline/x-mark

                          Menu open: "block", Menu closed: "hidden"
                        -->
                        <svg x-bind:class="{'!block' : mobileMenuOpen}"
                             class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
                <div class="flex flex-1 items-center justify-center md:items-stretch md:justify-start">
                    <div class="w-full h-16  bg-contain bg-no-repeat bg-center" style="background-image: url({{ asset('images/logos/pixelservices.webp') }})">
{#                        <img class="block w-auto <!--lg:hidden-->" src="images/logos/pixelservices.webp"#}
{#                             alt="Pixel Services">#}
                        {#          <img class="hidden h-8 w-auto lg:block" src="images/logos/pixelservices.webp" alt="Pixel Services"> #}
                    </div>
                </div>
            </div>
            <div class="hidden md:ml-6 md:block col-span-8 h-full">
                    <div class="w-full h-full flex justify-center items-center space-x-8 text-base">
                        <!-- Current: "bg-gray-900 text-white", Default: "text-gray-300 hover:bg-gray-700 hover:text-white" -->
                        <a href="{{ path('app_home') }}"
                           class=" px-3 py-2  font-semibold
                {% if (app.request.get('_route') == 'app_home') %} border-b-2  border-indigo-400 font-black  {% endif %}
                "
                           aria-current="page">
                            Accueil
                        </a>
                        <a href="{{ path('app_blog_index') }}"
                           class=" px-3 py-2  font-semibold
                {% if (app.request.get('_route') == 'app_blog_index') %}  border-b-2  border-indigo-400 font-black  {% endif %}
                "
                           aria-current="page">
                            Focus
                        </a>
{#                        <a href="{{ path('app_contact') }}"#}
{#                           class=" px-3 py-2   font-semibold#}
{#                {% if (app.request.get('_route') == 'app_contact') %}  border-b-2  border-indigo-400 font-black   {% endif %}#}
{#                "#}
{#                           aria-current="page">#}
{#                            Contact#}
{#                        </a>#}
                    </div>
            </div>
            <div class="col-span-2 hidden md:inline-flex justify-center items-center">
                <a href="{{ path('app_contact') }}" class="border-2 border-gray-800 rounded-full px-4 py-2"> Contact </a>
            </div>
        </div>

<!-- Mobile menu, show/hide based on menu state. -->
<div class="bg-gray-900 text-white hidden h-0 sm:hidden transition-height duration-[2000ms]" id="mobile-menu"
     :class="mobileMenuOpen ? '!block h-96' : 'hidden'"
        {#       x-bind:class="{'!block' : mobileMenuOpen}" x-transition #}
>
    <div class="space-y-1 px-2 pt-2 pb-3">
        <!-- Current: "bg-gray-900 text-white", Default: "text-gray-300 hover:bg-gray-700 hover:text-white" -->
        <a href="{{ path('app_home') }}"
           class="bg-gray-900 text-white block px-3 py-2 rounded-md text-base font-medium"
           aria-current="page">Accueil</a>
        <a href="{{ path('app_blog_index') }}"
           class="bg-gray-900 text-white block px-3 py-2 rounded-md text-base font-medium" aria-current="page">Focus</a>
        <a href="{{ path('app_contact') }}"
           class="bg-gray-900 text-white block px-3 py-2 rounded-md text-base font-medium"
           aria-current="page">Contact</a>
    </div>
</div>
</nav>
</div>