<!DOCTYPE html>
<html xmlns:og="http://ogp.me/ns#" lang="fr_BE">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">

    <title> {% block title %} Création de sites web Liège Brabant Wallon | Pixel Services {% endblock %}  </title>
    {% block metas %}
        <meta name="description"
              content="Création et maintenance de sites web à Liège et en Brabant Wallon. Service personnalisé pour indépendants, commerçants et associations souhaitant développer leur présence en ligne. Devis gratuit. Prix abordables"/>
{#              content="Pixel Services aide les indépendants, commerçants et associations à lancer leur présence en ligne facilement, même sans aucune connaissance technique préalable. Prix abordables"/>#}
    {% endblock %}
    <meta name="author" content="Novitz Jean-Philippe <novitz@gmail.com>"/>

    <meta name="copyright" content="Novitz Jean-Philippe / Pixel Services"/>
    <meta name="robots" content="index,follow"/>

    <meta property="og:title" content="{% block og_title %}Votre site web sur mesure, accompagné de A à Z par Pixel Services {% endblock %}"/>
    <meta property="og:type" content="{% block og_type %}article {% endblock %}"/>
    <meta property="og:url" content="{% block og_url %}{{ app.request.uri }}{% endblock %}"/>
    <meta property="og:image"
          content="{% block og_image %}https://pixelservices.be/images/logos/pixelservices.webp {% endblock %}"/>
    <meta property="og:site_name" content="{% block og_site_name %}Pixel Services {% endblock %}"/>
    <meta property="og:locale" content="{% block og_locale %}fr_BE{% endblock %}"/>
    <meta property="og:description"
          content="{% block og_description %}Vous souhaitez un site web professionnel qui reflète votre activité ? À Liège et en Brabant Wallon, Pixel Services crée, met à jour et répare des sites web sur mesure pour indépendants et PME. Contactez-nous pour un accompagnement personnalisé.{% endblock %}"/>
{#          content="{% block og_description %}Vous souhaitez lancer votre site web mais vous ne savez pas par où commencer ? Pixel Services vous accompagne pas à pas vers votre réussite en ligne. {% endblock %}"/>#}

{#    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.0/dist/cdn.min.js"></script>#}
    <link
            rel="icon"
            href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {# {% block javascripts %}
																																																							{{ encore_entry_script_tags('app') }}
																																																						{% endblock %} #}
</head>
<body class="bg-slate-50 min-h-screen  text-lg">
{% include '_partials/_navbar.html.twig' %}
<div class="w-full p-2 md:p-6 lg:p-8 md:max-w-6xl lg:max-w-7xl align-self-center min-h-screen  m-auto">

    {% for message in app.flashes('success') %}
        <div class="absolute top-16 left-1 right-1 bg-green-600/90  text-white px-8 py-4">
            {{ message|trans }}
        </div>
    {% endfor %}

    {% block body %}{% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}

    {% endblock %}

</div>
{% include '_partials/_footer.html.twig' %}
</body>
</html>