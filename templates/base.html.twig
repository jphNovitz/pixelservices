<!DOCTYPE html>
<html lang="fr-BE" class="h-full scroll-smooth"  >
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Language" content="fr-BE">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <title>{% block title %}Sites web pour artisans et indépendants - Court-Saint-Étienne{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}"/>
    <link rel="icon" type="image/png" href="{{ asset('favicon-96x96.png') }}" sizes="96x96"/>
    <link rel="shortcut icon" href="{{ asset('favicon.ico') }}"/>
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}"/>
    <link rel="manifest" href="{{ asset('site.webmanifest') }}"/>
    {% block metas %}
        <meta name="description"
              content="Création site vitrine à Court-Saint-Étienne : solution professionnelle pour artisans et indépendants. Valorisez vos services et renforcez votre image en ligne."/>
    {% endblock %}
    <meta name="author" content="Novitz Jean-Philippe <bonjour@jphiwe.be>"/>
    <meta name="copyright" content="Novitz Jean-Philippe <jphiweb.be>"/>
    {% block follow %}
        <meta name="robots" content="index,follow"/> 
    {% endblock %}
   
    <link rel="canonical" href="{{ absolute_url(app.request.attributes.get('_route')
    ? path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params', {}))
    : path(app.request.pathinfo)) }}" />

    <meta property="og:title"
          content="{% block og_title %}Sites web pour artisans et indépendants - Court-Saint-Étienne{% endblock %}"/>
    <meta property="og:type" content="{% block og_type %}website{% endblock %}"/>
    <meta property="og:url" content="{% block og_url %}{{ app.request.uri }}{% endblock %}"/>
    <meta property="og:image"
          content="{% block og_image %}https://jphiweb.be/images/jphiweb_facebook_image.webp{% endblock %}"/>
    <meta property="og:image:alt" content="{% block og_image_alt %}Site web à Court-Saint-Étienne{% endblock %}">

    <meta property="og:site_name" content="{% block og_site_name %}Sites web pour artisans et indépendants - Court-Saint-Étienne{% endblock %}"/>
    <meta property="og:locale" content="{% block og_locale %}fr_BE{% endblock %}"/>
    <meta property="og:description"
          content="{% block og_description %}Création site vitrine à Court-Saint-Étienne : solution professionnelle pour artisans et indépendants. Valorisez vos services et renforcez votre image en ligne.{% endblock %}"/>

    <!-- Image partagée sur les réseaux -->

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title"
          content="{% block twitter_title %}Sites web pour artisans et indépendants - Court-Saint-Étienne{% endblock %}">
    <meta name="twitter:description"
          content="{% block twitter_description %}Création site vitrine à Court-Saint-Étienne : solution professionnelle pour artisans et indépendants. Valorisez vos services et renforcez votre image en ligne.{% endblock %}">
    <meta name="twitter:image"
          content="{% block twitter_image %}https://jphiweb.be/images/jphiweb_facebook_image.webp {% endblock %}">
    <meta name="twitter:image:alt"
          content="{% block twitter_image_alt %}Sites web pour artisans et indépendants - Court-Saint-Étienne{% endblock %}">

   
    {% block stylesheets %}

        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

    {% endblock %}

   {%  block json_ld %}
       <script type="application/ld+json">
           {
               "@context": "https://schema.org",
               "@type": "ProfessionalService",
               "@id": "https://jphiweb.be/#organization",
               "name": "JPHiWeb",
               "legalName": "JPHiWeb",
               "url": "https://jphiweb.be",
               "logo": "https://jphiweb.be/images/votre-logo.png",
               "image": "https://jphiweb.be/images/jphiweb_facebook_image.webp",
               "description": "Partenaire web à Court-Saint-Étienne : création de sites vitrines, ecommerce, services web, optimisation pour artisans et PME en Brabant Wallon.",
               "telephone": "+32XXXXXXXXy",
               "email": "bonjour@jphiweb.be",
               "priceRange": "€€",
               "address": {
                   "@type": "PostalAddress",
                   "addressLocality": "Court-Saint-Étienne",
                   "postalCode": "1490",
                   "addressRegion": "Brabant Wallon",
                   "addressCountry": "BE"
               },
               "geo": {
                   "@type": "GeoCoordinates",
                   "latitude": 50.6333,
                   "longitude": 4.5667
               },
               "areaServed": [
                   "Court-Saint-Étienne",
                   "Brabant Wallon",
                   "Belgique"
               ],
               "openingHoursSpecification": [
                   {
                       "@type": "OpeningHoursSpecification",
                       "dayOfWeek": [
                           "Monday",
                           "Tuesday",
                           "Wednesday",
                           "Thursday",
                           "Friday"
                       ],
                       "opens": "09:00",
                       "closes": "18:00"
                   }
               ],
               "sameAs": [
                   "https://www.linkedin.com/in/jphnovitz",
                   "https://www.facebook.com/jphiweb/",
                   "https://www.instagram.com/jphiweb.be"
               ],
               "founder": {
                   "@type": "Person",
                   "name": "Novitz Jean-Philippe",
                   "jobTitle": "Fondateur",
                   "url": "https://www.linkedin.com/in/jphnovitz"
               }
           }
       </script>
    {% endblock %}

</head>

<body class="bg-base-300 text-pretty">

<div class="max-w-7xl m-auto pt-20 bg-base-200 text-base-content relative">
    {% include '_partials/_navbar.html.twig' %}

    {% for message in app.flashes('success') %}
        <div class="absolute top-16 left-1 right-1 bg-green-600/90  text-white px-8 py-4">
            {{ message|trans }}
        </div>
    {% endfor %}
    {% block breadcrumb %} {% endblock %}
    <main class="p-2 md:p-6 lg:p-8 min-h-screen m-auto">
        {% block body %}{% endblock %}
    </main>
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}


    {% endblock %}


</div>
{% include '_partials/_footer.html.twig' %}
</body>
</html>
