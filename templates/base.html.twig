<!DOCTYPE html>
<html lang="fr-BE" class="h-full"  >
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
    <title> {% block title %} Création de sites web Liège Brabant Wallon |Jphiweb {% endblock %}  </title>
    <link rel="icon" type="image/png" href="{{ asset('favicon-96x96.png') }}" sizes="96x96"/>
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}"/>
    <link rel="shortcut icon" href="{{ asset('favicon.ico') }}"/>
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}"/>
    <link rel="manifest" href="{{ asset('site.webmanifest') }}"/>
    {% block metas %}
        <meta name="description"
              content="Création et maintenance de sites web à Liège et en Brabant Wallon. Service personnalisé pour indépendants, commerçants et associations souhaitant développer leur présence en ligne. Devis gratuit. Prix abordables"/>
    {% endblock %}
    <meta name="author" content="Novitz Jean-Philippe <novitz@gmail.com>"/>
    <meta name="copyright" content="Novitz Jean-Philippe / Jphiweb"/>
    {% block follow %}
        <meta name="robots" content="index,follow"/> {% endblock %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Language" content="fr-BE">
    {# <link rel="canonical" href="{{ app.request.uri }}">#}
    {# <link rel="canonical" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params'), absolute=true) }}"> #}
    <link rel="canonical" href="{{ absolute_url(app.request.attributes.get('_route') 
    ? path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params', {}))
    : path(app.request.pathinfo)) }}" />

    <meta property="og:title"
          content="{% block og_title %}Votre site web sur mesure, accompagné de A à Z par Jphiweb {% endblock %}"/>
    <meta property="og:type" content="{% block og_type %}article {% endblock %}"/>
    <meta property="og:url" content="{% block og_url %}{{ app.request.uri }}{% endblock %}"/>
    <meta property="og:image"
          content="{% block og_image %} https://jphiweb.be/images/jphiweb_facebook_image.webp {% endblock %}"/>
    <meta property="og:image:alt" content="{% block og_image_alt %}Développeur web à Court-Saint-Étienne{% endblock %}">

    <meta property="og:site_name" content="{% block og_site_name %}JPHiWEB : Le Web du BW {% endblock %}"/>
    <meta property="og:locale" content="{% block og_locale %}fr_BE{% endblock %}"/>
    <meta property="og:description"
          content="{% block og_description %}Vous souhaitez un site web professionnel qui reflète votre activité ? À Liège et en Brabant Wallon,Jphiweb crée, met à jour et répare des sites web sur mesure pour indépendants et PME. Contactez-nous pour un accompagnement personnalisé.{% endblock %}"/>

    <!-- Image partagée sur les réseaux -->

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title"
          content="{% block twitter_title %}Développeur web en Brabant wallon - Sites Web sur mesure, landing page et vitrines{% endblock %}">
    <meta name="twitter:description"
          content="{% block twitter_description %}Création de sites web à Court-Saint-Étienne et dans tout le Brabant wallon. Sites vitrines, landing pages, e-commerce.{% endblock %}">
    <meta name="twitter:image"
          content="{% block twitter_image %}https://jphiweb.be/images/jphiweb_facebook_image.webp {% endblock %}">
    <meta name="twitter:image:alt"
          content="{% block twitter_image_alt %}Développeur web en Brabant wallon{% endblock %}">

    <link
            rel="icon"
            href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    {% block stylesheets %}

        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

    {% endblock %}


</head>

<body class="bg-base-300">

<div class="max-w-7xl m-auto pt-24 bg-base-200 text-base-content relative">
    {% include '_partials/_navbar.html.twig' %}

    {% for message in app.flashes('success') %}
        <div class="absolute top-16 left-1 right-1 bg-green-600/90  text-white px-8 py-4">
            {{ message|trans }}
        </div>
    {% endfor %}
    <div class="p-2 md:p-6 lg:p-8 min-h-screen m-auto">
        {% block body %}{% endblock %}
    </div>
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}


    {% endblock %}


</div>
{% include '_partials/_footer.html.twig' %}
</body>
</html>
