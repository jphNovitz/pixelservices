{% if (parentTopic is not null ) or (childrenTopics is not empty) or (relatedPosts is not empty) %}

    <aside{{ attributes.defaults({ class: "w-full p-4" }) }} aria-labelledby="related-reading">
        <nav aria-label="À lire aussi">
            <h2 id="related-reading" class="text-xl font-semibold mb-3">
                {{ 'more.about' |trans }} {{ topic.title }}
            </h2>

            {% if parentTopic is not null %}
                <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 mb-6">
                    <a href="{{ path('app_topic_show', {'slug': parentTopic.slug}) }}" class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow">
                        <figure class="relative aspect-video overflow-hidden">
                            {% if parentTopic.image %}
                                <img src="{{ asset('images/topic/' ~ parentTopic.image) }}" alt="{{ parentTopic.title }}" class="w-full h-full object-cover"/>
                            {% else %}
                                <div class="w-full h-full bg-base-200 flex items-center justify-center text-base-content/60">Aperçu</div>
                            {% endif %}
                        </figure>
                        <div class="card-body p-4">
                            <h3 class="card-title text-base md:text-lg">{{ parentTopic.title }}</h3>
                            {% if parentTopic.summary %}
                                <p class="text-sm opacity-80 line-clamp-3 overflow-hidden">{{ parentTopic.summary|striptags }}</p>
                            {% endif %}
                        </div>
                    </a>
                </div>
            {% endif %}

            {% if childrenTopics is not empty %}
                <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 mb-6">
                    {% for childTopic in childrenTopics %}
                        <a href="{{ path('app_topic_show', {'slug': childTopic.slug}) }}" class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow">
                            <figure class="relative aspect-video overflow-hidden">
                                {% if childTopic.image %}
                                    <img src="{{ asset('images/topic/' ~ childTopic.image) }}" alt="{{ childTopic.title }}" class="w-full h-full object-cover"/>
                                {% else %}
                                    <div class="w-full h-full bg-base-200 flex items-center justify-center text-base-content/60">Aperçu</div>
                                {% endif %}
                            </figure>
                            <div class="card-body p-4">
                                <h3 class="card-title text-base md:text-lg">{{ childTopic.title }}</h3>
                                {% if childTopic.summary %}
                                    <p class="text-sm opacity-80 line-clamp-3 overflow-hidden">{{ childTopic.summary|striptags }}</p>
                                {% endif %}
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

            {% if relatedPosts is not empty %}
                <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    {% for post in relatedPosts %}
                        <a href="{{ path('app_blog_show', {'slug': post.slug}) }}" class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow">
                            <figure class="relative aspect-video overflow-hidden">
                                {% if post.image %}
                                    <img src="{{ asset('images/blog/' ~ post.image) }}" alt="{{ post.title }}" class="w-full h-full object-cover"/>
                                {% else %}
                                    <div class="w-full h-full bg-base-200 flex items-center justify-center text-base-content/60">Aperçu</div>
                                {% endif %}
                            </figure>
                            <div class="card-body p-4">
                                <h3 class="card-title text-base md:text-lg">{{ post.title }}</h3>
                                {% if post.summary %}
                                    <p class="text-sm opacity-80 line-clamp-3 overflow-hidden">{{ post.summary|striptags }}</p>
                                {% endif %}
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </nav>
    </aside>
{% endif %}
