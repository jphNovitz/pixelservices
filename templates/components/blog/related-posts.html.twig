<aside{{ attributes.defaults({ class: "w-full p-4" }) }} aria-labelledby="related-content-title">
    <nav aria-label="Contenu associé">
        <h2 id="related-content-title" class="text-xl font-semibold mb-3">
            À lire aussi
        </h2>

        <ul class="list-disc list-inside space-y-1">
            <li>
                <a href="{{ path('app_topic_show', {'slug': relatedTopic.slug}) }}"
                   class="hover:underline">
                    {{ relatedTopic.title }}
                </a>
            </li>

            {% for post in relatedTopic.articles %}
                {% if currentPostId != post.id and post.slug is not empty %}
                    <li>
                        <a href="{{ path('app_blog_show', {'slug': post.slug}) }}"
                           class="hover:underline">
                            {{ post.title }}
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </nav>
</aside>
