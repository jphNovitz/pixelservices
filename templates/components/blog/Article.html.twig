<article class="w-full mx-auto mt-8 p-6 bg-white/10 rounded-lg shadow-lg">

    {% if home %}
        <h2 class="text-3xl font-bold text-left mb-12">
            {{ title }}
        </h2>
    {% else %}
        <h1 class="text-3xl font-bold text-left mb-12">
            {{ title }}
        </h1>
    {% endif %}
    {% if summary is defined %}
        <h2>{{ summary }}</h2>
    {% endif %}
    <section class="flex flex-col items-start leading-8 text-lg  my-8">
        {% if image_url is not empty %}
            <figure class="w-full text-center">
                <img class="w-full  md:w-3/4 h-auto  mx-auto  my-8  rounded-lg shadow-md"
                     src="{{ asset("images/blog/"~image_url) }}"
                        {% if image_alt is not empty %}
                            alt="{{ image_alt }}"
                        {% else %}
                            alt="Pixel Services"
                        {% endif %} />
            </figure>
        {% endif %}
        {{ content |raw }}

    </section>
</article>