{% extends 'base.html.twig' %}

{% block title %}Réalisations : sites web en Brabant wallon | Jphiweb{% endblock %}

{% block metas %}
    <meta name="description"
          content="Sites web réalisés pour des indépendants et associations en Brabant wallon : club sportif, sandwicherie, applications métier. Projets et démonstrations."/>
{% endblock %}

{% block og_title %}Réalisations : sites web pour indépendants en Brabant wallon{% endblock %}

{% block og_description %}Club sportif, sandwicherie, applications métier : les projets et démonstrations réalisés depuis Court-Saint-Étienne.{% endblock %}

{% block twitter_title %}Réalisations : sites web en Brabant wallon | Jphiweb{% endblock %}

{% block twitter_description %}Club sportif, sandwicherie, applications métier : les projets et démonstrations réalisés depuis Court-Saint-Étienne.{% endblock %}

{% block breadcrumb %}
    <div class="w-full flex justify-center items-center">

        <div class="breadcrumbs flex justify-center pt-4 text-sm">
            <ul>
                <li><a href="{{ path('app_home') }}" >Accueil</a></li>
                <li class="!mt-0">Réalisations</li>
            </ul>
        </div>
    </div>
{% endblock %}

{% block body %}
    <div class="min-h-screen  py-6">
        <div class="container mx-auto px-4">
            <h1 class="text-4xl font-bold text-center mb-8">Réalisations</h1>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for project in projects %}
                    <article class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
                        {% if project.image %}
                            <figure class="w-full aspect-video overflow-hidden bg-base-200">
                                <img src="/images/projets/{{ project.image }}"
                                     alt="{{ project.title }}"
                                     loading="lazy"
                                     decoding="async"
                                     class="w-full h-full object-cover"/>
                            </figure>
                        {% else %}
                            <figure class="w-full aspect-video overflow-hidden bg-base-200" aria-hidden="true"></figure>
                        {% endif %}
                        <div class="card-body">
                            <h2 class="card-title text-xl font-bold">
                                <a href="{{ path('app_project_show', {'slug': project.slug}) }}"
                                   class="link link-hover">{{ project.title }}</a>
                            </h2>
                            {% if project.header %}
                                <p class="text-base text-base-content/80">{{ project.header }}</p>
                            {% endif %}
                            <div class="card-actions justify-end mt-4">
                                <a href="{{ path('app_project_show', {'slug': project.slug}) }}"
                                   class="btn btn-primary"
                                   aria-label="Voir le projet {{ project.title }}">Voir le projet</a>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
