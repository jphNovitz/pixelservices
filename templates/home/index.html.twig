        </div>
        <div class="w-full grid md:grid-cols-3">

            <!-- BASIC -->

            <div class="card bg-base-100 shadow-xl">

                <div class="card-body">

                    <h3 class="card-title">Présence Web Express </h3>

                    <p><a href="https://jphiweb.be/service/creation-site-web-carte-de-visite" class="font-black link link-hover">Création
                            d'un site web carte de visite</a>:
                        </p>
                    <p class="py-2">Une page web responsive avec vos textes et images,
                        formulaire de contact et QR code pour partager facilement votre activité.</p>

                    <div class="py-8 text-2xl text-center font-bold relative before:content-['A_partir_de'] before:absolute  before:top-4 before:left-1/2 before:-translate-x-1/2 before:text-sm before:font-normal after:content-['HTVA'] after:ml-1.5 after:text-base after:font-medium ">145 €</div>

