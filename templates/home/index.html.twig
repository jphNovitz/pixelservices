            <!-- STANDARD -->

            <div class="card bg-base-100 shadow-xl border-2 border-primary">

                <div class="card-body">

                    <h3 class="card-title">Présence Web Boost
                        <div class="badge badge-primary">Populaire</div>
                    </h3>

                    <p><a href="https://jphiweb.be/service/creation-de-site-vitrine-a-court-saint-etienne"
