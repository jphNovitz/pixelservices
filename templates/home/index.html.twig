            <!-- PREMIUM -->

            <div class="card bg-base-100 shadow-xl">

                <div class="card-body">

                    <h3 class="card-title">Identité Web Complète</h3>

                    <p><a href="#"
                          class="font-black link link-hover">Création d'un site complet
                        </a></p>

                    <p class="py-2">Site complet de 5 pages avec optimisation SEO de base, configuration.</p>

                    <div class="py-8 text-2xl text-center font-bold relative before:content-['A_partir_de'] before:absolute  before:top-4 before:left-1/2 before:-translate-x-1/2 before:text-sm before:font-normal after:content-['HTVA'] after:ml-1.5 after:text-base after:font-medium ">720 €</div>

                    <div class="card-actions justify-end">

                        <a href="/contact" class="btn btn-primary w-full">Planifier un appel</a>

                    </div>

                </div>

