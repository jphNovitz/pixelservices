{% extends 'base.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}
{% block og_title %}{{ post.title }} {% endblock %}
{% block og_image %}{{ asset("images/blog/"~post.image) }}{% endblock %}
{% block og_description %} {{ post.summary }} {% endblock %}
{% block metas %}
    <meta name="description"
          content=" {{ post.summary }}"/>
    <meta name="keywords" content="site web, ecommerce, vitrine, site vitrine, wp, wordpress, wix"/>
{% endblock %}

{% block breadcrumb %}
    <div class="w-full flex justify-center items-center">

        <div class="breadcrumbs flex justify-center pt-4 text-sm">
            <ul>
                <li><a href="{{ path('app_home') }}" >Accueil</a></li>
                <li class="!mt-0"><a href="{{ path('app_blog_index') }}">Focus</a></li>
                <li class="!mt-0"><a href="{{ path('app_topic_show', {'slug': post.topic.slug}) }}">{{ post.topic.title }}</a></li>
                <li class="!mt-0">{{ post.title }}</li>
            </ul>
        </div>
    </div>
{% endblock %}

{% block body %}

    {{ component('Blog:Article', {
        'title' : post.title,
        'summary': post.summary,
        'content' : post.content,
        'image_url' : 'blog/'~post.image,
        'image_alt' : post.title,
        'home' :  app.request.pathinfo == '/'

    }) }}

    {% if post.topic is not empty and post.slug is not empty %}
        <twig:Blog:RelatedPosts topic="true" topicId="{{ post.topic.id }}" currentPostId="{{ post.id }}"/>
    {% endif %}
    {{ component('Button:Button', {
        href: path('app_blog_index'),
        label: 'Focus'
    }) }}



    {#    <div class="w-1/2 after:content-[','] hover:bg-blue-800"> ddsq</div> #}
{% endblock %}
