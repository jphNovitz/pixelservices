{% extends 'base.html.twig' %}

{% block title %}{{ post.seoTitle }}{% endblock %}
{% block metas %}
    <meta name="description"
          content=" {{ post.seoSummary }}"/>
    <meta name="keywords" content="site web, ecommerce, vitrine, site vitrine, wp, wordpress, wix"/>
{% endblock %}
{% block og_title %}{{ post.seoTitle }}{% endblock %}
{% block og_image %}{{ asset("images/blog/"~post.image) }} {% endblock %}
{% block og_image_alt %}{{ post.seoTitle }}{% endblock %}
{% block og_description %}{{ post.seoSummary }}{% endblock %}
{% block twitter_title %}{{ post.seoTitle }}{% endblock %}
{% block twitter_description %}{{ post.seoSummary }}{% endblock %}
{% block twitter_image %}{{ asset("images/blog/"~post.image) }} {% endblock %}
{% block twitter_image_alt %}{{ post.seoTitle }}{% endblock %}





{% block breadcrumb %}
    <div class="breadcrumbs flex justify-start md:justify-center pt-4 text-xs">
        <ul class="max-w-full flex flex-col md:flex-row !items-start md:!items-center space-x-2 ">
            <li><a href="{{ path('app_home') }}">Accueil</a></li>
            <li class="!mt-0"><a href="{{ path('app_blog_index') }}">Ressources</a></li>
            {% if post.topic %}
                <li class="!mt-0 text-ellipsis overflow-hidden"><a
                            href="{{ path('app_topic_show', {'slug': post.topic.slug}) }}">{{ post.topic.title }}</a>
                </li>
            {% endif %}
            <li class="!mt-0 text-ellipsis overflow-hidden">{{ post.title }}</li>
        </ul>
    </div>
{% endblock %}

{% block body %}

    {{ component('Blog:Article', {
        'title' : post.title,
        'summary': post.summary,
        'content' : post.content,
        'image_url' : 'blog/'~post.image,
        'image_alt' : post.title,
        'home' :  app.request.pathinfo == '/'

    }) }}

    {% if post.topic is not empty and post.slug is not empty %}
        <twig:Blog:RelatedPosts topic="true" topicId="{{ post.topic.id }}" currentPostId="{{ post.id }}"/>
    {% endif %}
    {{ component('Button:Button', {
        href: path('app_blog_index'),
        label: 'Focus'
    }) }}

{% endblock %}
