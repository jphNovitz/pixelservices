{% extends 'base.html.twig' %}

{% block title %}{{ post.seoTitle }}{% endblock %}
{% block metas %}
    <meta name="description"
          content=" {{ post.seoSummary }}"/>
    <meta name="keywords" content="site web, ecommerce, vitrine, site vitrine, wp, wordpress, wix"/>
{% endblock %}
{% block og_title %}{{ post.seoTitle }}{% endblock %}
{% block og_image %}{% if post.image %}{{ asset("images/blog/" ~ post.image) }}{% else %}{{ asset("images/jphiweb_facebook_image.webp") }}{% endif %}{% endblock %}
{% block og_image_alt %}{{ post.seoTitle }}{% endblock %}
{% block og_description %}{{ post.seoSummary }}{% endblock %}
{% block twitter_title %}{{ post.seoTitle }}{% endblock %}
{% block twitter_description %}{{ post.seoSummary }}{% endblock %}
{% block twitter_image %}{% if post.image %}{{ asset("images/blog/" ~ post.image) }}{% else %}{{ asset("images/jphiweb_facebook_image.webp") }}{% endif %}{% endblock %}
{% block twitter_image_alt %}{{ post.seoTitle }}{% endblock %}


{% block json_ld %}
    {% set schema = {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": post.seoTitle,
        "description": post.seoSummary,
        "datePublished": post.createdAt|date('c'),
        "dateModified": post.updatedAt|date('c'),
        "author": {
            "@type": "Person",
            "@id": "https://jphiweb.be/#person_jphnovitz",
            "name": "Novitz Jean-Philippe"
        },
        "publisher": {
            "@id": "https://jphiweb.be/#organization"
        },
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": url('app_blog_show', {slug: post.slug})
        },
        "articleSection": post.topic.title|default(post.topic),
        "abstract": post.summary,
        "articleBody": post.content|striptags|slice(0, 500)
    } %}

    {% set schema = schema|merge({
        "image": post.image
            ? absolute_url(asset('images/blog/' ~ post.image))
            : absolute_url(asset('images/jphiweb_facebook_image.webp'))
    }) %}

    <script type="application/ld+json">
        {{ schema|json_encode(256)|raw }}
    </script>
{% endblock %}


{% block breadcrumb %}
    <div class="breadcrumbs flex justify-start md:justify-center pt-8 text-xs">
        <ul class="max-w-full flex flex-col md:flex-row !items-start md:!items-center space-x-2 ">
            <li><a href="{{ path('app_home') }}">Accueil</a></li>
            <li class="!mt-0"><a href="{{ path('app_blog_index') }}">Ressources</a></li>
            {% if post.topic %}
                <li class="!mt-0 text-ellipsis overflow-hidden"><a
                            href="{{ path('app_topic_show', {'slug': post.topic.slug}) }}">{{ post.topic.title }}</a>
                </li>
            {% endif %}
            <li class="!mt-0 text-ellipsis overflow-hidden">{{ post.title }}</li>
        </ul>
    </div>
{% endblock %}

{% block body %}

    {{ component('Blog:Article', {
        'title' : post.title,
        'summary': post.summary,
        'content' : post.content,
        'image_url' : 'blog/'~post.image,
        'image_alt' : post.title,
        'home' :  app.request.pathinfo == '/'

    }) }}

    {% if post.topic is not empty and post.slug is not empty %}
        <twig:Blog:RelatedPosts topic="true" topicId="{{ post.topic.id }}" currentPostId="{{ post.id }}"/>
    {% endif %}
    {{ component('Button:Button', {
        href: path('app_blog_index'),
        label: 'Focus'
    }) }}

{% endblock %}
