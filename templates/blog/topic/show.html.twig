{% extends 'base.html.twig' %}

{% block title %}{{ topic.seoTitle }}{% endblock %}
{% block metas %}
    <meta name="description"
          content=" {{ topic.seoSummary }}"/>
    <meta name="keywords" content="site web, ecommerce, vitrine, site vitrine, wp, wordpress, wix"/>
{% endblock %}
{% block og_title %}{{ topic.seoTitle }}{% endblock %}
{% block og_image %}{{ asset("images/topic/"~topic.image) }} {% endblock %}
{% block og_image_alt %}{{ topic.seoTitle }}{% endblock %}
{% block og_description %}{{ topic.seoSummary }}{% endblock %}
{% block twitter_title %}{{ topic.seoTitle }}{% endblock %}
{% block twitter_description %}{{ topic.seoSummary }}{% endblock %}
{% block twitter_image %}{{ asset("images/topic/"~topic.image) }} {% endblock %}
{% block twitter_image_alt %}{{ topic.seoTitle }}{% endblock %}

{% block breadcrumb %}
    <nav class="breadcrumbs flex justify-start md:justify-center pt-4 text-xs w-full">
        <ul class="flex flex-col items-start w-full max-w-xs sm:max-w-sm md:max-w-md">
            <li class="w-full break-words">
                <a href="{{ path('app_home') }}">Accueil</a>
            </li>

            <li class="w-full break-words">
                <a href="{{ path('app_blog_index') }}">Ressources</a>
            </li>

            {% if topic.parentTopic %}
                <li class="w-full break-words truncate inline-block before:inline">
                    <a href="{{ path('app_topic_show', {'slug': topic.parentTopic.slug}) }}">
                        {{ topic.parentTopic.title }}
                    </a>
                </li>
            {% endif %}

            <li class="w-full break-words font-semibold truncate before:content-['›'] before:inline before:mr-1">
                {{ topic.title }}
            </li>
        </ul>
    </nav>



{% endblock %}

{% block body %}
    <article class="w-full mx-auto mt-8 p-6 bg-white/10 rounded-lg shadow-lg">
        <div class="max-w-2xl mx-auto">

            <header class="mb-12">
                <h1 class="text-3xl font-bold text-left">
                    {{ topic.title }}
                </h1>

                {% if topic.summary is not empty %}
                    <p class="mt-4">{{ topic.summary }}</p>
                {% endif %}

                <a class="btn btn-primary mt-6" href="{{ path('app_contact') }}">
                    {{ 'get_started' | trans }}
                </a>
            </header>

            <div class="flex flex-col items-start leading-8 text-lg mx-auto my-8">

                {% if topic.image is defined and topic.image is not empty %}
                    <figure class="w-full text-center">
                        <img
                                class="w-full md:w-3/4 h-auto mx-auto my-8 rounded-lg shadow-md"
                                src="{{ asset('images/topic/' ~ topic.image) }}"
                                loading="lazy"
                                {% if topic.image_alt is defined and  topic.image_alt is not empty %}
                                    alt="{{ topic.image_alt }}"
                                {% else %}
                                    alt="{{ topic.seoTitle }}"
                                {% endif %}
                        />
                    </figure>
                {% endif %}

                {{ topic.content | raw }}
            </div>

        </div>
    </article>

    <twig:Topic:RelatedPosts topicId="{{ topic.id }}" class="bg-base-200"/>

