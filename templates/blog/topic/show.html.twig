{% extends 'base.html.twig' %}

{% block title %}{{ topic.title }} | Le web du BW{% endblock %}

{% block metas %}
    <meta name="description"
          content=" {{ topic.title}}"/>
    <meta name="keywords" content="site web, ecommerce, vitrine, site vitrine, wp, wordpress, wix"/>
{% endblock %}
{% block og_title %}{{ topic.title}}{% endblock %}"/>
{% block og_image %}{{ asset("images/topic/"~image) }} {% endblock %}"/>
{% block og_image_alt %}{{ topic.title }} | Le web du BW {% endblock %}"/>
{% block og_description %}{{ topic.title }}{% endblock %}


<meta name="twitter:title" content="{% block twitter_title %}{{ topic.title }} | Le web du BW{% endblock %}">
<meta name="twitter:description" content="{% block twitter_description %}{{ topic.title }} | Le web du BW{% endblock %}">
<meta name="twitter:image" content="{% block twitter_image %}{{ asset("images/topic"~image) }} {% endblock %}">
<meta name="twitter:image:alt" content="{% block twitter_image_alt %}{{ topic.title }} | Le web du BW{% endblock %}">



{% block body %}

    {{ component('Blog:Article', {
        'title' : topic.title,
        'summary': '',
        'content' : topic.content,
        'image_url' : '/topic/'~topic.image,
        'image_alt' : topic.title,
        'home' :  app.request.pathinfo == '/'

    }) }}


    {{ component('Button:Button', {
        href: path('app_blog_index'),
        label: 'Focus'
    }) }}



{#    <div class="w-1/2 after:content-[','] hover:bg-blue-800"> ddsq</div>#}
{% endblock %}
